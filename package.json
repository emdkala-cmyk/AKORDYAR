{
  "name": "akordyar",
  "version": "1.0.0",
  "description": "Akordyar — Chord editor & DAW (desktop installable edition)",
  "main": "electron-main.js",
  "author": "Akordyar",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:web": "node server.js",
    "server": "node server.js",
    "test": "node js/tests/run-all-tests.js",
    "lint": "node js/quality/lint.js",
    "quality:diff-check": "git diff --check",
    "quality:architecture": "node js/quality/line-budget.js",
    "quality:core-refactor": "node js/quality/core-refactor-budget.js",
    "quality:legacy-deps": "node js/quality/legacy-dependency-budget.js",
    "quality": "npm test && npm run lint && npm run quality:diff-check && npm run quality:architecture && npm run quality:legacy-deps",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:all": "electron-builder --win nsis portable",
    "pack": "electron-builder --win --dir"
  },
  "dependencies": {
    "express": "^4.18.2",
    "jsdom": "^24.0.0",
    "opensheetmusicdisplay": "^2.1.2",
    "qrcode": "^1.5.4",
    "qrcode-generator": "^1.5.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.akordyar.app",
    "productName": "Akordyar",
    "copyright": "Copyright © 2026 Akordyar",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "server.js",
      "server/**/*",
      "parser-test.js",
      "Akordyar.html",
      "sync-client.html",
      "package.json",
      "js/**/*",
      "styles/**/*",
      "fonts/**/*",
      "assets/**/*",
      "build/icon.png",
      "build/icon.ico",
      "node_modules/express/**/*",
      "node_modules/jsdom/**/*",
      "node_modules/opensheetmusicdisplay/**/*",
      "node_modules/ws/**/*"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Akordyar",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Akordyar-Portable-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
